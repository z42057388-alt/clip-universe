{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sdrdnvatefhfncusriml.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vidtube-mcp",
      "version": "0.1.0",
      "title": "VidTube MCP"
    },
    "tools": [
      {
        "name": "list_videos",
        "title": "List videos",
        "description": "List videos on VidTube. Optionally filter to the signed-in user's own videos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "Max number of videos to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "mine_only": {
              "default": false,
              "description": "If true, return only the signed-in user's videos.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_video",
        "title": "Get video",
        "description": "Fetch details of a single VidTube video by its ID, including comments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "video_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The UUID of the video."
            }
          },
          "required": [
            "video_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "post_comment",
        "title": "Post comment",
        "description": "Post a comment on a VidTube video as the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "video_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID of the video to comment on."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Comment text."
            }
          },
          "required": [
            "video_id",
            "content"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "my_profile",
        "title": "My profile",
        "description": "Get the signed-in user's VidTube profile (username, avatar, bio).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
